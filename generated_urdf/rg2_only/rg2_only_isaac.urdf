      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="1.0E-03" ixy="1.0E-06" ixz="1.0E-06" iyy="1.0E-03" iyz="1.0E-06" izz="1.0E-03" />
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="file:///home/mohammadnsr1/watchdog/WatchDog_V1/ros2_ws/src/onrobot_rg_description/meshes/rg2/visual/outer_knuckle.stl" /></geometry><material name=""><color rgba="0.8 0.8 0.8 1" /></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="file:///home/mohammadnsr1/watchdog/WatchDog_V1/ros2_ws/src/onrobot_rg_description/meshes/rg2/collision/outer_knuckle.stl" /></geometry><sdf resolution="512"/></collision>
  </link>

