<?xml version="1.0"?>
<robot name="onrobot_rg2">
  <!-- Source repo: https://github.com/ABC-iRobotics/onrobot-ros2 -->
  <!-- Copied package: ros2_ws/src/onrobot_rg_description -->
  <!-- This standalone model adopts the ABC-iRobotics RG2 naming and joint structure. -->
  <!-- The old six custom Isaac RG2 linkage joint names are intentionally not preserved here. -->
  <!-- This file is for Isaac Sim RG2-only inspection and now matches the final full-robot RG2 link naming. -->

  <link name="world"/>
  <link name="onrobot_rg2_base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.7" />
      <inertia ixx="1.0E-03" ixy="1.0E-06" ixz="1.0E-06" iyy="1.0E-03" iyz="1.0E-06" izz="1.0E-03" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/mohammadnsr1/watchdog/WatchDog_V1/ros2_ws/src/onrobot_rg_description/meshes/rg2/visual/base_link.stl" />
      </geometry>
      <material name="">
        <color rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/mohammadnsr1/watchdog/WatchDog_V1/ros2_ws/src/onrobot_rg_description/meshes/rg2/collision/base_link.stl" />
      </geometry>
      <sdf resolution="512"/>
    </collision>
  </link>

  <link name="onrobot_rg2_left_outer_knuckle">
