  <joint name="onrobot_rg2_base_to_body_joint" type="fixed">
    
    
    <parent link="onrobot_rg2_base_link"/>
    
    
    <child link="onrobot_rg2_body_link"/>
    
    
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    
  
  </joint>
  
  
  <joint name="onrobot_rg2_body_to_finger_1_origin_joint" type="revolute">
    <parent link="onrobot_rg2_body_link"/>
    <child link="onrobot_rg2_finger_1_origin"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-0.0 0.999949 -0.010122"/>
    <limit lower="0.0" upper="1.18" effort="50.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  
  
  <joint name="onrobot_rg2_body_to_finger_2_origin_joint" type="revolute">
    <parent link="onrobot_rg2_body_link"/>
    <child link="onrobot_rg2_finger_2_origin"/>
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
    <axis xyz="-0.0 0.999949 -0.010122"/>
    <limit lower="-1.19" upper="1.19" effort="50.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
    <!-- Upstream RG2FT mimic mapping; tune only if local visual import proves the linkage sign is wrong. -->
    <mimic joint="onrobot_rg2_body_to_finger_1_origin_joint" multiplier="1" offset="0"/>
  </joint>
  
  
