<?xml version="1.0"?>
<package format="3">
  <name>isaac_trajectory_bridge_interfaces</name>
  <version>0.1.0</version>
  <description>ROS 2 service and action interfaces for Isaac trajectory bridge controllers.</description>
  <maintainer email="mohammadnsr1@example.com">mohammadnsr1</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>action_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
