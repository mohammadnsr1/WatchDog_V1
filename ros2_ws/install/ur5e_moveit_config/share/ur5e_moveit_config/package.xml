<?xml version="1.0"?>
<package format="3">
  <name>ur5e_moveit_config</name>
  <version>0.0.1</version>
  <description>Minimal manual MoveIt 2 configuration package for the UR5e.</description>

  <maintainer email="mohammadnsr1@example.com">mohammadnsr1</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>srdfdom</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
